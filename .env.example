# PostgreSQL bağlantı adresi. Yerelde Docker/PostgreSQL ya da ücretsiz bir Neon/Supabase veritabanı
# kullanabilirsiniz. Vercel'de Storage > Neon (ya da Supabase) bağlandığında otomatik eklenir.
DATABASE_URL="postgresql://kullanici:parola@localhost:5432/proje1"
# Oturum imzası için gizli anahtar (en az 32 karakter, rastgele). HER müşteri kopyasında yenileyin:
#   openssl rand -base64 32
#   Windows: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Örnek değerle ya da 32 karakterden kısa değerle canlıda giriş çalışmaz.
AUTH_SECRET="degistir-bunu-en-az-32-karakterlik-rastgele-bir-degerle"
# Sitenin yayın adresi. sitemap, canonical ve yapılandırılmış veri bu adresle üretilir.
# Her müşteri kopyasında kendi alan adıyla değiştirin (örn. https://musteri-alanadi.com).
SITE_URL="http://localhost:3000"

# Yeni mesaj gelince ofisin e-postasına bildirim (isteğe bağlı).
# SMTP_HOST boşsa bildirim kapalıdır; mesajlar yine Admin > Mesajlar'da görünür.
# Bilgileri müşterinin e-posta/hosting sağlayıcısından alın. Parolayı yalnızca bu dosyaya yazın.
# SMTP_HOST="smtp.musteri-alanadi.com"
# SMTP_PORT="587"          # 465 ise bağlantı otomatik şifreli (SSL) kurulur
# SMTP_USER="bildirim@musteri-alanadi.com"
# SMTP_PASS="eposta-parolasi"
# MAIL_FROM="bildirim@musteri-alanadi.com"   # boşsa SMTP_USER kullanılır
# NOTIFY_EMAIL="info@musteri-alanadi.com"    # boşsa İletişim sayfasındaki e-posta kullanılır

# Mükellef Köşesi (isteğe bağlı). Yüklenen belgeler bu klasörde, web'den erişilemeyen bir yerde tutulur.
# Boşsa proje klasöründeki ./storage/portal kullanılır. Yedeklemeyi unutmayın.
# PORTAL_STORAGE_DIR="/var/lib/musteri-belgeleri"
# PORTAL_MAX_UPLOAD_MB="25"     # tek dosya sınırı (en çok 25)
# PORTAL_QUOTA_MB="500"         # mükellef başına toplam alan

# Dosya depolama (Hakkımda fotoğrafı ve Mükellef Köşesi belgeleri).
# - Vercel: projeye ÖZEL (private) bir Blob mağazası bağlayın (Storage > Blob > Private); bu değişken
#   kendiliğinden eklenir. Tanımlıysa dosyalar Blob'da, değilse diskte (PORTAL_STORAGE_DIR) tutulur.
# - Vercel işlevlerinin istek gövdesi sınırı 4,5 MB olduğundan orada tek dosya en çok 4 MB'tır.
# BLOB_READ_WRITE_TOKEN=""

# İlk yönetici hesabı (yalnızca `npm run db:seed` çalışırken ve hiç kullanıcı yokken kullanılır).
# Boşsa herkesçe bilinen varsayılan bilgiler (README) kullanılır; canlıda mutlaka kendinizinkini verin:
#   ADMIN_EMAIL="siz@ofis.com" ADMIN_PASSWORD="en-az-10-karakter" npm run db:seed
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""
