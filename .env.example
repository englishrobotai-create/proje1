DATABASE_URL="file:./dev.db"
AUTH_SECRET="degistir-bu-gizli-anahtari-uzun-ve-rastgele"
# Sitenin yayın adresi. sitemap, canonical ve yapılandırılmış veri bu adresle üretilir.
# Her müşteri kopyasında kendi alan adıyla değiştirin (örn. https://musteri-alanadi.com).
SITE_URL="http://localhost:3000"

# Yeni mesaj gelince ofisin e-postasına bildirim (isteğe bağlı).
# SMTP_HOST boşsa bildirim kapalıdır; mesajlar yine Admin > Mesajlar'da görünür.
# Bilgileri müşterinin e-posta/hosting sağlayıcısından alın. Parolayı yalnızca bu dosyaya yazın.
# SMTP_HOST="smtp.musteri-alanadi.com"
# SMTP_PORT="587"          # 465 ise bağlantı otomatik şifreli (SSL) kurulur
# SMTP_USER="bildirim@musteri-alanadi.com"
# SMTP_PASS="eposta-parolasi"
# MAIL_FROM="bildirim@musteri-alanadi.com"   # boşsa SMTP_USER kullanılır
# NOTIFY_EMAIL="info@musteri-alanadi.com"    # boşsa İletişim sayfasındaki e-posta kullanılır

# Mükellef Köşesi (isteğe bağlı). Yüklenen belgeler bu klasörde, web'den erişilemeyen bir yerde tutulur.
# Boşsa proje klasöründeki ./storage/portal kullanılır. Yedeklemeyi unutmayın.
# PORTAL_STORAGE_DIR="/var/lib/musteri-belgeleri"
# PORTAL_MAX_UPLOAD_MB="25"     # tek dosya sınırı (en çok 25)
# PORTAL_QUOTA_MB="500"         # mükellef başına toplam alan
