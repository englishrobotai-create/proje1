generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
}

model Setting {
  id               String   @id @default("main")
  siteTitle        String
  facebook         String   @default("")
  instagram        String   @default("")
  linkedin         String   @default("")
  twitter          String   @default("")
  youtube          String   @default("")
  whatsapp         String   @default("")
  externalNewsUrl  String   @default("https://www.ozcankutlu.com/tr/blog")
  externalNewsLabel String  @default("Özcan Kutlu Blog")
  updatedAt        DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  slug      String   @unique
  excerpt   String
  content   String
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}
